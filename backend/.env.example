# Sonolo backend — local development environment template.
# Copy to `.env` and adjust as needed. Non-secret defaults only:
# never put real secrets in this file, and never commit a real `.env`.

# Application metadata (also reported by /api/health).
APP_NAME=Sonolo API
APP_VERSION=0.1.0
ENVIRONMENT=local

# Root log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Prefix applied to all API routes. Health endpoint: GET /api/health.
API_PREFIX=/api

# Allowed CORS origins, as a JSON array.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Async database URL (local development PostgreSQL via asyncpg).
DATABASE_URL=postgresql+asyncpg://sonolo:sonolo@localhost:5432/sonolo

# Seconds of silence before a listening voice turn auto-ends.
VOICE_SILENCE_TIMEOUT=2.0

# JWT authentication. The default secret is for LOCAL DEVELOPMENT ONLY —
# generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
